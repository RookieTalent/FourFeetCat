<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.fourfeetcat</groupId>
    <artifactId>fourfeetcat</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>fourfeetcat-boot</artifactId>
  <name>FourFeetCat :: Boot</name>
  <description>Spring Boot 启动模块：主类、自动配置、依赖聚合，打 fat JAR</description>

  <dependencies>
    <dependency>
      <groupId>org.fourfeetcat</groupId>
      <artifactId>fourfeetcat-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.fourfeetcat</groupId>
      <artifactId>fourfeetcat-cli</artifactId>
    </dependency>
    <dependency>
      <groupId>org.fourfeetcat</groupId>
      <artifactId>fourfeetcat-channel-cli</artifactId>
    </dependency>
    <dependency>
      <groupId>org.fourfeetcat</groupId>
      <artifactId>fourfeetcat-provider</artifactId>
    </dependency>
    <dependency>
      <groupId>org.fourfeetcat</groupId>
      <artifactId>fourfeetcat-storage</artifactId>
    </dependency>
    <!-- 能力四（第19节起有实质内容：出站通知的契约与通用 webhook 实现）。
         此前无任何模块依赖它，不接上则新类既进不了容器（@Component 成死注解）也进不了 fat jar。 -->
    <dependency>
      <groupId>org.fourfeetcat</groupId>
      <artifactId>fourfeetcat-tool</artifactId>
    </dependency>
    <!-- 能力三（第22节起有实质内容：记忆门面、四档后端与 save/recall 工具）。
         同第19节教训：不接上则新类既进不了容器也进不了 fat jar。 -->
    <dependency>
      <groupId>org.fourfeetcat</groupId>
      <artifactId>fourfeetcat-memory</artifactId>
    </dependency>
    <!-- 生产环境结构化 JSON 日志（logback-spring.xml prod profile） -->
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- 集成冒烟（第26节）：WebSmokeIT 是唯一跑"真上下文 + 真 HTTP"的测试，必须真被执行。
           Spring Boot 父 pom 只在 pluginManagement 里备好了 failsafe 的配置（includes **/*IT.java、版本号），
           **不在这里声明插件它就永远不会跑**——实测踩过：`mvn verify` 日志里只有 *Test，冒烟测试等于没有。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
