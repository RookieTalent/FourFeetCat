<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.fourfeetcat</groupId>
    <artifactId>fourfeetcat</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>fourfeetcat-boot</artifactId>
  <name>FourFeetCat :: Boot</name>
  <description>Spring Boot 启动模块：主类、自动配置、依赖聚合，打 fat JAR</description>

  <dependencies>
    <dependency>
      <groupId>org.fourfeetcat</groupId>
      <artifactId>fourfeetcat-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.fourfeetcat</groupId>
      <artifactId>fourfeetcat-cli</artifactId>
    </dependency>
    <dependency>
      <groupId>org.fourfeetcat</groupId>
      <artifactId>fourfeetcat-channel-cli</artifactId>
    </dependency>
    <dependency>
      <groupId>org.fourfeetcat</groupId>
      <artifactId>fourfeetcat-provider</artifactId>
    </dependency>
    <dependency>
      <groupId>org.fourfeetcat</groupId>
      <artifactId>fourfeetcat-storage</artifactId>
    </dependency>
    <!-- 能力四（第19节起有实质内容：出站通知的契约与通用 webhook 实现）。
         此前无任何模块依赖它，不接上则新类既进不了容器（@Component 成死注解）也进不了 fat jar。 -->
    <dependency>
      <groupId>org.fourfeetcat</groupId>
      <artifactId>fourfeetcat-tool</artifactId>
    </dependency>
    <!-- 生产环境结构化 JSON 日志（logback-spring.xml prod profile） -->
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
