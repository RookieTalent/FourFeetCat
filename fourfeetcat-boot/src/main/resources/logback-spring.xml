<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- 统一走 SLF4J，禁止 System.out（阿里 P3C 规约兜底拦截） -->

  <!-- 开发环境：彩色 console，含 MDC traceId -->
  <springProfile name="dev,default">
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{36}) [traceId=%X{traceId:-}] - %msg%n</pattern>
      </encoder>
    </appender>
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
    </root>
  </springProfile>

  <!-- 生产环境：结构化 JSON（LogstashEncoder），MDC 字段（含 traceId）自动进 JSON -->
  <springProfile name="prod">
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <customFields>{"service":"fourfeetcat"}</customFields>
      </encoder>
    </appender>
    <root level="INFO">
      <appender-ref ref="JSON"/>
    </root>
  </springProfile>
</configuration>
