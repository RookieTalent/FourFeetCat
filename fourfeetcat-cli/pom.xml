<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.fourfeetcat</groupId>
    <artifactId>fourfeetcat</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>fourfeetcat-cli</artifactId>
  <name>FourFeetCat :: CLI</name>
  <description>命令行入口：Picocli 主入口、子命令、ConfigLoader</description>

  <dependencies>
    <dependency>
      <groupId>org.fourfeetcat</groupId>
      <artifactId>fourfeetcat-core</artifactId>
    </dependency>
    <!-- chat 的交互实现在 channel-cli（技术方案 §8.4：CliChannel 归该模块） -->
    <dependency>
      <groupId>org.fourfeetcat</groupId>
      <artifactId>fourfeetcat-channel-cli</artifactId>
    </dependency>
    <!-- session list 读会话仓储 -->
    <dependency>
      <groupId>org.fourfeetcat</groupId>
      <artifactId>fourfeetcat-storage</artifactId>
    </dependency>
    <!-- 命令行框架：子命令、参数、帮助信息、报错提示都交给它（课件"别自己撸 args[]"） -->
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <!-- provider list / status 读打包内全局层声明（轻命令不启动容器，YAML 得自己解） -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
    </dependency>
    <!-- WebApplicationType / ConfigurableApplicationContext：重命令按需取容器，但不自己持有应用配置类 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot</artifactId>
    </dependency>
  </dependencies>
</project>
