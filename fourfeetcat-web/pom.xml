<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.fourfeetcat</groupId>
    <artifactId>fourfeetcat</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>fourfeetcat-web</artifactId>
  <name>FourFeetCat :: Web</name>
  <description>能力五：WebServer、ApiController、GlobalExceptionHandler、OpenAPI（Spring MVC + 虚拟线程，禁响应式）</description>

  <dependencies>
    <dependency>
      <groupId>org.fourfeetcat</groupId>
      <artifactId>fourfeetcat-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.fourfeetcat</groupId>
      <artifactId>fourfeetcat-storage</artifactId>
    </dependency>
    <!-- HTTP 层：Spring MVC（宪法原则七：同步模型 + 虚拟线程，禁响应式） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- 监控：Actuator + Prometheus -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <!-- API 文档：springdoc OpenAPI（Swagger UI /swagger-ui.html） -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>
  </dependencies>
</project>
