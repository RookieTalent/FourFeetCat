<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>org.fourfeetcat</groupId>
  <artifactId>fourfeetcat</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>FourFeetCat</name>
  <description>FourFeetCat —— 面向企业场景的 Distributed AI Agent OS（多模块父工程）</description>

  <modules>
    <module>fourfeetcat-core</module>
    <module>fourfeetcat-provider</module>
    <module>fourfeetcat-memory</module>
    <module>fourfeetcat-tool</module>
    <module>fourfeetcat-channel-cli</module>
    <module>fourfeetcat-web</module>
    <module>fourfeetcat-storage</module>
    <module>fourfeetcat-cli</module>
    <module>fourfeetcat-boot</module>
  </modules>

  <properties>
    <java.version>21</java.version>

    <!-- 依赖版本（未列出者由 spring-boot-starter-parent 托管） -->
    <spring-ai.version>1.1.2</spring-ai.version>
    <spring-ai-alibaba.version>1.1.2.3</spring-ai-alibaba.version>
    <springdoc.version>2.9.1</springdoc.version>
    <sqlite-jdbc.version>3.53.4.0</sqlite-jdbc.version>
    <!-- 必须与 spring-boot-starter-parent 托管的 hibernate.version 完全一致（SQLite 方言） -->
    <hibernate-community-dialects.version>6.6.53.Final</hibernate-community-dialects.version>
    <picocli.version>4.7.7</picocli.version>
    <logstash-encoder.version>9.0</logstash-encoder.version>

    <!-- 质量插件版本 -->
    <maven-enforcer-plugin.version>3.6.1</maven-enforcer-plugin.version>
    <spotless.version>3.10.2</spotless.version>
    <!-- PMD 7：内嵌 ASM 可读 Java 21（class major 65）字节码；p3c-pmd 2.1.1 基于 PMD 6，
         对 Java 21 类型解析必崩（Unsupported class file major version 65），故弃用阿里细则，
         改走 PMD7 官方 category 规则集（见 build.plugins 注释，构成方略风险表逃生通道的执行）。 -->
    <maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version>
    <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
    <!-- 覆盖插件内嵌 checkstyle（默认 9.3 解析不了 Java 21 语法） -->
    <checkstyle.version>10.26.1</checkstyle.version>
    <spotbugs-plugin.version>4.10.4.1</spotbugs-plugin.version>
    <findsecbugs.version>1.14.0</findsecbugs.version>
    <dependency-check.version>13.0.0</dependency-check.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- LLM 技术栈：Spring AI 与 Spring AI Alibaba 成对锁定（alibaba 在后，自家版本优先）。
           宪法原则二：Spring AI 只用于协议转换 + @Tool schema 生成，禁用自动 tool 执行。 -->
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.alibaba.cloud.ai</groupId>
        <artifactId>spring-ai-alibaba-bom</artifactId>
        <version>${spring-ai-alibaba.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- 第三方（Boot 不托管的） -->
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>${sqlite-jdbc.version}</version>
      </dependency>
      <dependency>
        <groupId>org.hibernate.orm</groupId>
        <artifactId>hibernate-community-dialects</artifactId>
        <version>${hibernate-community-dialects.version}</version>
      </dependency>
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <dependency>
        <groupId>net.logstash.logback</groupId>
        <artifactId>logstash-logback-encoder</artifactId>
        <version>${logstash-encoder.version}</version>
      </dependency>

      <!-- 本项目模块间版本统一由父 pom 管理，子模块声明依赖不写版本 -->
      <dependency>
        <groupId>org.fourfeetcat</groupId>
        <artifactId>fourfeetcat-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.fourfeetcat</groupId>
        <artifactId>fourfeetcat-provider</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.fourfeetcat</groupId>
        <artifactId>fourfeetcat-memory</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.fourfeetcat</groupId>
        <artifactId>fourfeetcat-tool</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.fourfeetcat</groupId>
        <artifactId>fourfeetcat-channel-cli</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.fourfeetcat</groupId>
        <artifactId>fourfeetcat-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.fourfeetcat</groupId>
        <artifactId>fourfeetcat-storage</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.fourfeetcat</groupId>
        <artifactId>fourfeetcat-cli</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.fourfeetcat</groupId>
        <artifactId>fourfeetcat-boot</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <!-- 仅做版本 / 插件类路径锁定；活跃执行绑定见下方 build.plugins -->
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-pmd-plugin</artifactId>
          <version>${maven-pmd-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${maven-checkstyle-plugin.version}</version>
          <dependencies>
            <dependency>
              <groupId>com.puppycrawl.tools</groupId>
              <artifactId>checkstyle</artifactId>
              <version>${checkstyle.version}</version>
            </dependency>
          </dependencies>
        </plugin>
        <plugin>
          <groupId>com.github.spotbugs</groupId>
          <artifactId>spotbugs-maven-plugin</artifactId>
          <version>${spotbugs-plugin.version}</version>
          <dependencies>
            <dependency>
              <groupId>com.h3xstream.findsecbugs</groupId>
              <artifactId>findsecbugs-plugin</artifactId>
              <version>${findsecbugs.version}</version>
            </dependency>
          </dependencies>
        </plugin>
        <plugin>
          <groupId>org.owasp</groupId>
          <artifactId>dependency-check-maven</artifactId>
          <version>${dependency-check.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <!-- 质量门禁：随 verify 生命周期执行，任一红即构建失败 -->
    <plugins>
      <!-- 环境门禁：JDK 21 / Maven 3.9+（validate 阶段） -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <configuration>
          <rules>
            <requireJavaVersion>
              <version>[21,)</version>
            </requireJavaVersion>
            <requireMavenVersion>
              <version>[3.9,)</version>
            </requireMavenVersion>
          </rules>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>enforce</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- 格式层（Google）：Spotless + google-java-format（宪法：格式冲突以 GJF 为准） -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <configuration>
          <java>
            <googleJavaFormat>
              <style>GOOGLE</style>
            </googleJavaFormat>
            <removeUnusedImports/>
            <importOrder/>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- 编码规约（PMD 7）：p3c-pmd 2.1.1 与 Java 21 不兼容（详见 properties 注释），
           改用 PMD7 官方 category 规则集——bestpractices + errorprone 覆盖常见编码规约
           （阿里手册的核心条目多落在此两类），既不误伤业务代码又可读 Java 21。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <configuration>
          <rulesets>
            <ruleset>category/java/bestpractices.xml</ruleset>
            <ruleset>category/java/errorprone.xml</ruleset>
          </rulesets>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- 兜底静态检查：Checkstyle（google_checks）+ 仓库根 suppression -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <configuration>
          <configLocation>google_checks.xml</configLocation>
          <!-- 子模块基于各自 basedir 运行，suppressions 放仓库根由 multiModuleProjectDirectory 定位 -->
          <suppressionsLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/checkstyle-suppressions.xml</suppressionsLocation>
          <failOnViolation>true</failOnViolation>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- 安全检查：SpotBugs + Find Security Bugs（effort=Max 扫描 OWASP Top 10 类漏洞） -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <configuration>
          <effort>Max</effort>
          <threshold>Low</threshold>
          <!-- FindSecBugs 的 SPRING_ENDPOINT 把每个 Controller 当信息项提示（本工程 API 端点遍地皆是），
               属固有噪音，统一排除；真正的 Spring 安全漏洞检测器（CSRF/注入等）不受影响 -->
          <excludeFilterFile>${maven.multiModuleProjectDirectory}/config/spotbugs/spotbugs-exclude.xml</excludeFilterFile>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- OWASP Dependency-Check：扫第三方依赖已知 CVE。慢（NVD API 限流），
         不挂默认 verify —— CI 用独立 job，本地 mvn verify -Pdependency-check 主动触发 -->
    <profile>
      <id>dependency-check</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <configuration>
              <failBuildOnCVSS>7</failBuildOnCVSS>
              <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
              <formats>
                <format>HTML</format>
                <format>JSON</format>
              </formats>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>aggregate</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
