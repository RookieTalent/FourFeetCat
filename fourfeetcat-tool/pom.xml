<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.fourfeetcat</groupId>
    <artifactId>fourfeetcat</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>fourfeetcat-tool</artifactId>
  <name>FourFeetCat :: Tool</name>
  <description>能力四（三合一）：内置 Tool、MCP Client、ToolRegistry、SandboxChecker（宪法原则八：不拆模块）</description>

  <dependencies>
    <dependency>
      <groupId>org.fourfeetcat</groupId>
      <artifactId>fourfeetcat-core</artifactId>
    </dependency>
    <!-- 出站通知（第19节）：通用 webhook 实现用 RestClient；版本由 Boot BOM 托管 -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <!-- @Component 所需的 spring-context（与 fourfeetcat-cli 同款声明，不靠传递） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot</artifactId>
    </dependency>
    <!-- MCP 客户端（第20节）：同步客户端 + stdio 传输。版本由父 pom 的 dependencyManagement 钉死。
         它的 reactor-core 传递依赖早已随 Spring AI 在本工程 classpath 上（research.md D5），不新增异步栈。 -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp</artifactId>
    </dependency>
    <!-- 读 .fourfeetcat/mcp_servers.yaml（与 fourfeetcat-cli 同款声明） -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
