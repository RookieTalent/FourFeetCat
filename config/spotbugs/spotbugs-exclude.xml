<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- SPRING_ENDPOINT 是 FindSecBugs 的信息级探测器：凡 @RestController/@Controller 皆报。
       FourFeetCat 本身就是 REST 服务，该提示无安全增益，统一排除；
       真正的 Spring 安全规则（CSRF 不受限映射、路径穿越、注入类）不在排除之列。 -->
  <Match>
    <Bug pattern="SPRING_ENDPOINT"/>
  </Match>

  <!-- Profile 是 record 值对象：紧凑构造器已做防御性不可变化（null 容器落空集合、其余
       unmodifiable 包装）。EI_EXPOSE_REP/EI_EXPOSE_REP2 只看字段类型不看 unmodifiable 包装，
       对 record 访问器属固有误报；真正的可变暴露（构造后可被外部改）已被拷贝消解。 -->
  <Match>
    <Class name="org.fourfeetcat.core.profile.Profile"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>

  <!-- 同上：ProviderProperties record 紧凑构造器已 List.copyOf 防御性拷贝。 -->
  <Match>
    <Class name="org.fourfeetcat.provider.ProviderConfiguration$ProviderProperties"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>

  <!-- SpringAiProviderServiceImpl.chat 的 catch 后原样重抛是课件第16节钦定形态（"调用失败也留痕，再把错误抛给
       上层处理"）。精确重抛使 javac 在字节码 throws 属性标记 RuntimeException，触发该 Low 级形态
       探测器；语义无变化（异常类型、消息原样上抛），属固有噪音。
       注：本类由 ProviderService 改名而来（6a8a699），排除项随改名同步。 -->
  <Match>
    <Class name="org.fourfeetcat.provider.SpringAiProviderServiceImpl"/>
    <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
  </Match>

  <!-- CliChannel 持有外部注入的 InputStream/PrintStream：流不可拷贝，EI_EXPOSE_REP2 无从消解。
       注入只为让 /quit 与空行两条分支有机器守卫（CliChannelTest）——交互壳的全部价值就是读写这两个流，
       "防御性拷贝"在这里没有语义。 -->
  <Match>
    <Class name="org.fourfeetcat.channel.cli.CliChannel"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>

  <!-- INFORMATION_EXPOSURE_THROUGH_AN_ERROR_MESSAGE：命中的是 CLI 的统一报错出口。那条规则的场景是
       "错误信息回给未授权的远端调用方"；CLI 的 stderr 只给敲命令的这一个人看，不存在这一层。
       把异常消息泛化成"操作失败"反而让操作者无从排障（key 没配 / Agent 不存在 / 模型端 401 全靠这行）。 -->
  <Match>
    <Class name="org.fourfeetcat.cli.CommandErrors"/>
    <Bug pattern="INFORMATION_EXPOSURE_THROUGH_AN_ERROR_MESSAGE"/>
  </Match>

  <!-- EI_EXPOSE_REP/EI_EXPOSE_REP2：WebhookNotifyAdapter 构造注入 RestClient（Spring 的线程安全 HTTP 客户端）。
       实现类本身不持有可变的业务状态，"防御性拷贝"对一个共享的框架客户端没有语义；构造注入是本仓既定的依赖注入
       形态（与 CliChannel 的流注入同因，第18节）。 -->
  <Match>
    <Class name="org.fourfeetcat.tool.notify.WebhookNotifyAdapter"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>

  <!-- CRLF_INJECTION_LOGS：profile 包只在本地工作区错误路径记录文件名与异常消息，输入非
       网络/对话用户可控（Profile 文件由部署者自管），日志注入风险不适用；sanitizing 会削弱
       排障信息。对话用户可控的输入进入日志的路径（未来 Channel/CLI 层）不在本排除之列。 -->
  <Match>
    <Class name="~org\.fourfeetcat\.core\.profile\..*"/>
    <Bug pattern="CRLF_INJECTION_LOGS"/>
  </Match>

  <!-- 同上：ContextLoader 的告警只记工作区里 Bootstrap 文件的路径（部署者自管的本地输入，
       非网络/对话用户可控）；sanitizing 会让"到底缺哪个文件"这条排障信息变模糊。 -->
  <Match>
    <Class name="org.fourfeetcat.core.react.ContextLoader"/>
    <Bug pattern="CRLF_INJECTION_LOGS"/>
  </Match>

  <!-- 第20节：内置 HTTP 工具与 MCP 适配器构造注入框架客户端（RestClient / McpSyncClient）。
       与 WebhookNotifyAdapter 同因——被注入的是共享的框架对象，不可拷贝、也不该拷贝；
       "防御性拷贝"在这里没有语义，构造注入是本仓既定的依赖注入形态。 -->
  <Match>
    <Class name="org.fourfeetcat.tool.builtin.HttpTools"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="org.fourfeetcat.tool.mcp.McpToolAdapter"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>

  <!-- COMMAND_INJECTION：ShellTools 是**故意**执行外部命令的工具，FindSecBugs 无从知道上游有白名单。
       该工具的设计恰好是该规则要防的两件事的反面：① 参数以 argv 数组直传，不经 shell 解释（`;`、`|` 只是
       普通字符）；② 方法体第一行就是 sandbox.enforce(SHELL_COMMAND, command)，命令须在管理员配置的
       可执行文件白名单内，不在即抛异常、进程根本不启动。真正的隔离强度由沙箱档位决定（白名单为"劝阻级"
       防线，见 docs/TechnicalSolution.md §6.7），不因本条排除而改变。
       ⚠️ 复核提示：若将来有人把这里的 argv 直传改成拼接字符串交给 shell，本条排除就成了漏洞掩护——改那种
       写法时必须同时删除本条。 -->
  <Match>
    <Class name="org.fourfeetcat.tool.builtin.ShellTools"/>
    <Bug pattern="COMMAND_INJECTION"/>
  </Match>

  <!-- CRLF_INJECTION_LOGS：MCP 客户端的告警只记 mcp_servers.yaml 里的服务名与传输方式——该文件由部署者
       自管，不是网络或对话用户可控的输入；与 profile 包同款理由。sanitizing 会让"哪个 server 没连上"
       这条唯一的排障线索变模糊。 -->
  <Match>
    <Class name="org.fourfeetcat.tool.mcp.McpClientService"/>
    <Bug pattern="CRLF_INJECTION_LOGS"/>
  </Match>

  <!-- THROWS_METHOD_THROWS_RUNTIMEEXCEPTION：CallbackTool.execute 刻意把 Spring AI 包装过的异常拆开重抛。
       不拆的话，沙箱拦截的原因会被埋进"调用方法失败"这类包装文案里，而审计表的失败原因是给人查事故用的。
       与 SpringAiProviderServiceImpl 的排除同因（精确重抛触发该 Low 级形态探测器，语义无变化）。 -->
  <Match>
    <Class name="org.fourfeetcat.tool.registry.AnnotatedToolAdapter$CallbackTool"/>
    <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
  </Match>
</FindBugsFilter>
